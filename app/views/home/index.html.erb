<div class="min-h-screen bg-gradient-to-br from-gray-900 via-purple-900 to-black text-white">
  <header class="p-6 flex justify-between items-center max-w-7xl mx-auto">
    <div>
      <h1 class="text-4xl font-bold bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
        Coin Monitor
      </h1>
      <p class="text-sm text-gray-300 mt-1">Real-time currency monitoring</p>
    </div>
  </header>

  <main class="p-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 isolate">
      <% @currencies.each do |currency| %>
      <div class="p-6 rounded-xl bg-white/10 backdrop-blur-xl hover:scale-105 hover:shadow-2xl transition transform will-change-transform hover:z-10">
        <h3 class="text-lg font-bold"><%= currency[:name] %></h3>
        <p class="text-sm text-gray-400"><%= currency[:code] %></p>

        <p class="mt-2 text-2xl font-bold">
          <% if currency[:code].include?("BTC") %>
          $<%= number_with_precision(currency[:price], precision: 2, delimiter: ",") %>
          <% else %>
          R$ <%= number_with_precision(currency[:price], precision: 4, delimiter: ",") %>
          <% end %>
        </p>

        <p class="mt-1 text-md bg-white/20 rounded-lg p-2 w-fit font-bold hover:bg-white/30 transition-all duration-300 <%= currency[:change24h] >= 0 ? 'text-green-400' : 'text-red-400' %>">
          <%= currency[:change24h].round(2) %>%
        </p>
      </div>
      <% end %>
    </div>

    <div class="mt-12 p-6 rounded-xl bg-white/10 backdrop-blur-l max-w-4xl mx-auto isolate">
      <h3 class="text-xl font-bold mb-4">Market Overview</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% @currencies.each do |currency| %>
        <div class="text-center">
          <p class="text-2xl font-bold <%= currency[:change24h] >= 0 ? 'text-green-400' : 'text-red-400' %>">
            <% if currency[:code].include?("BTC") %>
            $<%= number_with_precision(currency[:price], precision: 2, delimiter: ",") %>
            <% else %>
            R$ <%= number_with_precision(currency[:price], precision: 4, delimiter: ",") %>
            <% end %>
          </p>
          <p class="text-sm text-gray-300"><%= currency[:name] %></p>
        </div>
        <% end %>
      </div>
    </div>

    <div class="mt-12 p-6 rounded-xl bg-white/10 backdrop-blur-xl max-w-6xl mx-auto isolate mb-12">
      <h3 class="text-xl font-bold mb-6 text-center">Price Trends (Last 15 Days)</h3>
      <div class="relative h-80">
        <canvas id="currencyChart" class="w-full h-full"></canvas>
      </div>
    </div>

    <footer class="p-6 text-center text-gray-400 text-sm">
      <p>Developed by <a href="https://github.com/devanaclimgo" class="text-white hover:text-gray-300">Ana Gomes</a> in 2025</p>
    </footer>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('currencyChart').getContext('2d');

    // Get currency data from the server
    console.log('Fetching currency data...');
    fetch('/api/currency', {
        method: 'GET',
        headers: {
          'Cache-Control': 'no-cache',
          'Pragma': 'no-cache'
        }
      })
      .then(response => {
        console.log('Response status:', response.status);
        console.log('Response headers:', response.headers);
        return response.json();
      })
      .then(data => {
        console.log('Received data:', data);

        if (!data || data.length === 0) {
          throw new Error('No data received from API');
        }

        const datasets = data.map(currency => ({
          label: currency.name,
          data: currency.sparklineData,
          borderColor: currency.color,
          backgroundColor: currency.color + '20',
          borderWidth: 2,
          fill: false,
          tension: 0.4,
          pointRadius: 0,
          pointHoverRadius: 6,
          pointHoverBackgroundColor: currency.color,
          pointHoverBorderColor: '#ffffff',
          pointHoverBorderWidth: 2
        }));

        console.log('Created datasets:', datasets);

        new Chart(ctx, {
          type: 'line',
          data: {
            labels: Array.from({
              length: 15
            }, (_, i) => `Day ${i + 1}`),
            datasets: datasets
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                labels: {
                  color: '#ffffff',
                  font: {
                    size: 14,
                    weight: 'bold'
                  },
                  usePointStyle: true,
                  pointStyle: 'circle'
                }
              },
              tooltip: {
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                titleColor: '#ffffff',
                bodyColor: '#ffffff',
                borderColor: 'rgba(255, 255, 255, 0.2)',
                borderWidth: 1,
                cornerRadius: 8,
                displayColors: true
              }
            },
            scales: {
              x: {
                grid: {
                  color: 'rgba(255, 255, 255, 0.1)',
                  drawBorder: false
                },
                ticks: {
                  color: '#9ca3af',
                  font: {
                    size: 12
                  }
                }
              },
              y: {
                grid: {
                  color: 'rgba(255, 255, 255, 0.1)',
                  drawBorder: false
                },
                ticks: {
                  color: '#9ca3af',
                  font: {
                    size: 12
                  },
                  callback: function(value) {
                    return 'R$ ' + value.toFixed(2);
                  }
                }
              }
            },
            interaction: {
              intersect: false,
              mode: 'index'
            },
            elements: {
              point: {
                hoverRadius: 8
              }
            }
          }
        });

        console.log('Chart created successfully');
      })
      .catch(error => {
        console.error('Error fetching chart data:', error);
        document.getElementById('currencyChart').parentElement.innerHTML =
          '<div class="flex items-center justify-center h-full text-gray-400">Failed to load chart data: ' + error.message + '</div>';
      });
  });
</script>